# Salin ke .env bila ingin mengubah nilai default: cp .env.example .env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Laju dan "kekacauan" data dari producer
EVENTS_PER_SECOND=20
LATE_RATIO=0.05
VERY_LATE_RATIO=0.01
INVALID_RATIO=0.02

# Parameter streaming
STREAM_WINDOW=1 minute
STREAM_WATERMARK=10 minutes
STREAM_TRIGGER=10 seconds
